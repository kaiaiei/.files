{  
    "position": "top",	
    "layer": "bottom",
    "exclusive": true,
    "modules-left": ["clock","custom/spotify"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["network","pulseaudio","custom/power"],

    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}",
        "tooltip": false
    },

    "hyprland/workspaces": {
	"format": "{name}",
	"format-icons": {
	    "A": " ",
            "B": " ",
	    "C": " ",
	    "D": " ",
	    "E": " ",
	    "active": " ",
	    "default": " "
        },
       	   "persistent-workspaces": {
             	 "*": 5, // 5 workspaces by default on every monitor
                 "HDMI-A-1": 5 //but only three on HDMI-A-1
           }
    },


    "hyprland/window": {
   	 "format": "",
   	 "rewrite": {
        	"(.*) — Mozilla Firefox": "🌎 $1",
        	"(.*) - fish": "> [$1]"
    	},
   	 "separate-outputs": true
    },

    "pulseaudio": {
    	"format": "{volume}% {icon}",
    	"format-bluetooth": "{volume}% {icon}    ",
    	"format-muted": "  ",
    	"format-icons": {
        	"alsa_output.pci-0000_00_1f.3.analog-stereo": "  ",
        	"alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "  ",
        	"headphone": "  ",
        	"hands-free": "  ",
        	"headset": "  ",
        	"phone": "  ",
        	"phone-muted": "  ",
        	"portable": "  ",
        	"car": "  ",
        	"default": ["  ", "  "]
    	},
    	"scroll-step": 1,
    	"on-click": "pavucontrol",
    	"ignored-sinks": ["Easy Effects Sink"],
        "tooltip": false
    },

    "network": {
   	 "interface": "wlp4s0",
   	 "format": "{ifname}",
   	 "format-wifi": " {essid}     ",
   	 "format-ethernet": "{ipaddr}/{cidr} 󰊗",
   	 "format-disconnected": "", //An empty format will hide the module.
   	 "tooltip": false,
   	 "max-length": 50,
         "tooltip": false
    },
    "custom/power": {
        "format": "⏻ ", // Icon
        "on-click": "~/.local/bin/wlogout-hide", // Or a script for power menu
        "tooltip": false
    },


    "custom/spotify": {
        "format": " {}",
        "max-length": 40,
        "interval": 1,
        "exec": "playerctl -p spotify metadata --format '{{artist}} - {{title}}'",
        "exec-if": "pgrep spotify",
        "on-click": "playerctl -p spotify play-pause",
        "on-scroll-up": "playerctl -p spotify next",
        "on-scroll-down": "playerctl -p spotify previous",
        "escape": true,
        "tooltip": false
    }


}
